{
    // Set my default vscode preferences.
    // Necessary vscode extensions are:
    // Python
    // Python Debugger
    // BasedPyright
    // Ruff
    // LaTeX
    // LaTeX Workshop

    // Python vscode preferences
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",

    "[windows]": {
        "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe"
    },
    "[osx]": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
    },
    "[linux]": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
    },

    "python.languageServer": "None",
    "editor.semanticHighlighting.enabled": true,
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true
    },
    

    // LaTeX vscode preferences
    "latex-workshop.latex.recipes": [
        {
            "name": "latexmk 🔃",
            "tools": [
                "latexmk"
            ]
        }
    ],
    "latex-workshop.latex.autoBuild.run": "onSave",
    "latex-workshop.latex.currentRecipe.name": "latexmk 🔃",
    "files.exclude": {
        "**/Docs/*/*.aux": true,
        "**/Docs/*/*.log": true,
        "**/Docs/*/*.fls": true,
        "**/Docs/*/*.fdb_latexmk": true,
        "**/Docs/*/*.synctex.gz": true,
        "**/Docs/*/*.bbl": true,
        "**/Docs/*/*.blg": true,
        "**/Docs/*/*.out": true,
        "**/Docs/*/*.toc": true,
        "**/Docs/*/*.lof": true,
        "**/Docs/*/*.lot": true,
        "**/Docs/*/*.bcf": true,
        "**/Docs/*/*.run.xml": true
    }
}